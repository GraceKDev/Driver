# Compose / local Docker
POSTGRES_USER=chaosdrive
POSTGRES_PASSWORD=chaosdrive
POSTGRES_DB=chaosdrive

# Public origin and cookie policy
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# API
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Host=db;Port=5432;Database=chaosdrive;Username=chaosdrive;Password=chaosdrive
App__Origin=http://localhost:3000
Cookie__Secure=false
AWS__Region=ap-southeast-1
AWS__BucketName=chaosdrive-files-544885083248-ap-southeast-1
DataProtection__KeysPath=/keys

# Compose substitutes these into the API environment
AWS_REGION=ap-southeast-1
AWS_BUCKET_NAME=chaosdrive-files-544885083248-ap-southeast-1

# Web -> API (container network)
API_URL=http://api:8080
